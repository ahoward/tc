#!/usr/bin/env bash

# xtitle - set terminal title to argument or basename of current directory

# Get the title: first arg or basename of pwd
title="${1:-$(basename "$PWD")}"

# Check if we're in tmux
if [ -n "$TMUX" ]; then
  # In tmux, we need to wrap the escape sequence for passthrough
  echo -en "\033Ptmux;\033\033]0;${title}\007\033\\"
else
  # Not in tmux - use standard sequences
  echo -en "\033]0;${title}\007"
fi
